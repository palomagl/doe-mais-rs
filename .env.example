# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# Pegue em: https://app.supabase.com  ->  Project Settings -> API
#
# IMPORTANTE: use a chave "publishable"/"anon" (pode ir para o cliente).
# NUNCA coloque a service_role key aqui.

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
